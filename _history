   captureThrow()\n})\nfunction dumpThrow () {\n    basic.showIcon(IconNames.SmallDiamond)\n    emit(\"# throw \" + throwId + \" gref=\" + grx + \",\" + gry + \",\" + grz)\n    emit(\"t,x,y,z,mx,my\")\n    for (let i = 0; i <= bt.length - 1; i++) {\n        emit(\"\" + bt[i] + \",\" + bx[i] + \",\" + by[i] + \",\" + bz[i] + \",\" + bmx[i] + \",\" + bmy[i])\n        basic.pause(OUT_PAUSE)\n    }\n    emit(\"# end\")\n    basic.showIcon(IconNames.Yes)\n    basic.pause(200)\n    basic.clearScreen()\n}\nlet s = 0\nlet gry = 0\nlet grx = 0\nlet throwId = 0\nlet connected = false\nlet start = 0\nlet bmy: number[] = []\nlet bmx: number[] = []\nlet bz: number[] = []\nlet by: number[] = []\nlet bx: number[] = []\nlet bt: number[] = []\nlet grz = 0\nlet OUT_PAUSE = 0\nlet SAMPLE_PAUSE = 0\nlet CAPTURE_MS = 0\nlet MAX_SAMPLES = 0\nserial.setBaudRate(BaudRate.BaudRate115200)\ninput.setAccelerometerRange(AcceleratorRange.EightG)\nbluetooth.startUartService()\nMAX_SAMPLES = 200\nCAPTURE_MS = 1500\nlet TRIGGER_MG = 2600\nlet STILL_MG = 1300\nSAMPLE_PAUSE = 5\nOUT_PAUSE = 8\ngrz = 1024\nlet armed = true\nbasic.forever(function () {\n    s = input.acceleration(Dimension.Strength)\n    if (armed && s > TRIGGER_MG) {\n        armed = false\n        throwId += 1\n        captureThrow()\n        while (input.acceleration(Dimension.Strength) > STILL_MG) {\n            basic.pause(50)\n        }\n        basic.pause(300)\n        armed = true\n    } else if (armed) {\n        if (connected) {\n            led.plot(2, 2)\n        } else {\n            led.plot(0, 0)\n            led.plot(4, 0)\n        }\n        if (s < STILL_MG) {\n            grx = input.acceleration(Dimension.X)\n            gry = input.acceleration(Dimension.Y)\n            grz = input.acceleration(Dimension.Z)\n        }\n    }\n    basic.pause(15)\n})\n","README.md":"","pxt.json":"{\n    \"name\": \"Disc-o-tech\",\n    \"description\": \"\",\n    \"dependencies\": {\n        \"core\": \"*\",\n        \"microphone\":